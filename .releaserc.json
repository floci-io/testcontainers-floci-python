{
  "tagFormat": "${version}",
  "branches": [
    {
      "name": "release/+([0-9])?(.{+([0-9]),x}).x",
      "channel": "${name.replace(/^release\\//,'')}"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "python3 -c \"import re, sys; f=open('pyproject.toml'); c=f.read(); f.close(); c=re.sub(r'(?m)^version = \\\".*\\\"', 'version = \\\"${nextRelease.version}\\\"', c); open('pyproject.toml','w').write(c)\""
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["pyproject.toml", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
